{
  "name": "release-log",
  "version": "0.0.0",
  "private": true,
  "description": "Deterministic PR-based changelogs and AI-assisted release notes",
  "license": "MIT",
  "bin": {
    "release-log": "dist/src/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE.md"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/src/release-plan.js"
  },
  "scripts": {
    "build": "node scripts/build.ts",
    "prepack": "pnpm build",
    "test": "node --test --experimental-test-coverage tests/*.test.ts",
    "prepare": "lefthook install",
    "format": "oxfmt --write .",
    "check:format": "oxfmt --check .",
    "check:lint": "oxlint --deny-warnings .",
    "check:types": "tsc --noEmit",
    "check:commits": "commitlint",
    "check:commit-range": "node scripts/check-commit-range.ts",
    "check:pr-title": "commitlint --config commitlint.pr.config.mjs",
    "check:pr-metadata": "node scripts/check-pr-metadata.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "check": "pnpm check:format && pnpm check:lint && pnpm check:types && pnpm test && pnpm docs:build",
    "verify": "pnpm check"
  },
  "dependencies": {
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/lint": "21.2.4",
    "@commitlint/load": "21.2.4",
    "@commitlint/parse": "21.2.3",
    "mdast-util-from-markdown": "2.1.0",
    "toml-eslint-parser": "1.0.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@types/eslint": "9.6.1",
    "@types/node": "26.6.6",
    "lefthook": "2.2.2",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "7.0.2",
    "vitepress": "1.6.4"
  },
  "engines": {
    "node": ">=26.13.0 <27",
    "pnpm": "12.14.0"
  },
  "packageManager": "pnpm@12.14.0"
}
