{
  "name": "release-log",
  "version": "0.8.3",
  "private": true,
  "description": "Deterministic PR-based releases for GitHub repositories",
  "license": "MIT",
  "author": {
    "name": "Luc Joosten",
    "email": "lhajoosten@outlook.com"
  },
  "bin": {
    "release-log": "dist/src/cli.js"
  },
  "files": [
    "dist/src"
  ],
  "type": "module",
  "scripts": {
    "build": "node scripts/build.ts",
    "prepack": "pnpm build",
    "test": "node --test --experimental-test-coverage tests/*.test.ts",
    "test:integration": "node --test tests/*.integration.test.ts",
    "test:all": "node --test tests/*.test.ts",
    "prepare": "lefthook install",
    "format": "oxfmt --write .",
    "format:files": "oxfmt --write --no-error-on-unmatched-pattern --",
    "check:format": "oxfmt --check .",
    "check:lint": "oxlint --deny-warnings .",
    "check:types": "tsc --noEmit",
    "check:commits": "commitlint",
    "check:commit-range": "node scripts/check-commit-range.ts",
    "check:pr-title": "commitlint --config commitlint.pr.config.mjs",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "check:static": "pnpm check:format && pnpm check:lint && pnpm check:types",
    "check": "pnpm check:static && pnpm test && pnpm build && pnpm docs:build",
    "verify": "pnpm check"
  },
  "dependencies": {
    "toml-eslint-parser": "1.0.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@types/eslint": "9.6.1",
    "@types/node": "26.6.6",
    "lefthook": "2.2.2",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "7.0.2",
    "vitepress": "1.6.4"
  },
  "engines": {
    "node": ">=26.13.0 <27",
    "pnpm": "12.14.0"
  },
  "packageManager": "pnpm@12.14.0"
}
